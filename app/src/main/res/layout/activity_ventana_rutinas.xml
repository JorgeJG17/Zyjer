<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/halloween_screen_background">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/departuremonoregular"
                android:text="@string/crear_rutina_titulo"
                android:textColor="#FFAA32"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/crear_rutina_intro"
                android:textColor="#E9DDEB"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="#D924142B"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/departuremonoregular"
                    android:text="@string/crear_rutina_nombre"
                    android:textColor="#FFAA32"
                    android:textSize="17sp" />

                <EditText
                    android:id="@+id/textNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/crear_rutina_nombre_ejemplo"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#BBAEC0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/departuremonoregular"
                    android:text="@string/crear_rutina_dias"
                    android:textColor="#FFAA32"
                    android:textSize="17sp" />

                <EditText
                    android:id="@+id/textDias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/crear_rutina_dias_ejemplo"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#BBAEC0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/crear_rutina_ayuda"
                    android:textColor="#D4C6D6"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btSiguienteRut"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/halloween_action_button"
                android:fontFamily="@font/departuremonoregular"
                android:onClick="crearRutClick"
                android:text="@string/crear_rutina_continuar"
                android:textSize="17sp"
                app:backgroundTint="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Creado por: Jorge Jiménez Garrido\nVersión: 2.0"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
